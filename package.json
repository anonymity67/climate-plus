{
  "name": "climateplus-collaborator-kit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Climate++ research prototype and reproducible data handoff",
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build && npm run verify:data",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:handoff": "node scripts/verify-manifest.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "chain:install": "npm ci --prefix tools/local-chain",
    "chain": "node tools/local-chain/server.mjs",
    "test:chain": "npm test --prefix tools/local-chain"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.4",
    "prettier": "3.9.10"
  }
}
