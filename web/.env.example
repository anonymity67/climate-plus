# The public product runs without authentication. For an operator hostname:
# AQUAVELLE_AUTH_MODE=access
# AQUAVELLE_OPERATOR_ORIGIN=https://field.yourdomain.example
# AQUAVELLE_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# AQUAVELLE_ACCESS_AUDIENCE=<Cloudflare Access application audience>
# AQUAVELLE_D1_ID=<database UUID>
# AQUAVELLE_WORKER_NAME=aquavelle
