{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:climateplus:observation:v1",
  "title": "Climate++ single measured observation input",
  "type": "object",
  "required": ["date", "latitude", "longitude"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "location": { "type": "string", "maxLength": 200 },
    "river": { "type": "string", "maxLength": 200 },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "ph": { "type": ["number", "null"], "minimum": 0, "maximum": 14 },
    "do": { "type": ["number", "null"], "minimum": 0, "maximum": 30 },
    "cod": { "type": ["number", "null"], "minimum": 0 },
    "units": {
      "type": "object",
      "properties": { "do": { "const": "mg/L" }, "cod": { "const": "mg/L" } }
    }
  },
  "anyOf": [
    { "required": ["ph"], "properties": { "ph": { "type": "number" } } },
    { "required": ["do"], "properties": { "do": { "type": "number" } } },
    { "required": ["cod"], "properties": { "cod": { "type": "number" } } }
  ],
  "allOf": [
    {
      "if": { "required": ["do"], "properties": { "do": { "type": "number" } } },
      "then": { "required": ["units"], "properties": { "units": { "required": ["do"] } } }
    },
    {
      "if": { "required": ["cod"], "properties": { "cod": { "type": "number" } } },
      "then": { "required": ["units"], "properties": { "units": { "required": ["cod"] } } }
    }
  ],
  "additionalProperties": true
}
